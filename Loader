local cloneref = cloneref or clonereference or function(instance)
    return instance
end

local game = game
local HttpGet = game.HttpGet
local loadstring = loadstring

local Players = cloneref(game:GetService("Players"))

repeat task.wait() until game:IsLoaded() and Players.LocalPlayer

local Files = {
    [6556072] = "https://api.luarmor.net/files/v4/loaders/5c03a0921eeeda66881f655770668907.lua", -- A Universal Time
    [35929511] = "https://api.luarmor.net/files/v4/loaders/437fa347915089f24e360b15b7e7c255.lua", -- Anime Expeditions
    [559846885] = "https://api.luarmor.net/files/v4/loaders/1efc66eb89eebb5635bbe3270474b9b3.lua", -- Iron Soul
    [111457579] = "https://api.luarmor.net/files/v4/loaders/5146a7dd957988744e53941d35dd29ea.lua", -- Anime Origins
}

local Link = Files[game.CreatorId]

if not Link then
    return warn("UNSUPPORTED GAME 🤡")
end

local Success, Result = pcall(loadstring(HttpGet(game, Link)))

if not Success then
    warn("LOAD FAILED:", Result)
end
